PORT=8080
# DOCS_ONLY=true serves the website while /v1/* returns 503; no Jev/API key needed.
# DOCS_ONLY=false is the default for self-hosted validation.
DOCS_ONLY=false
SEMANTIC_VALIDATOR_API_KEY=local-dev
# Optional individual-key mode. Docker: /data/keys.json; local Go: data/keys.json.
# When set, SEMANTIC_VALIDATOR_API_KEY is ignored.
API_KEYS_FILE=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT=30s
